# Windows lab config. Copy to ../lab.env (same directory) and edit.
# Everything here is host-side; no secrets.

# a name you can find with `pgrep -f "name $VMNAME"`
VMNAME=${VMNAME:-leonida-win}

# host-side ports
SSH_PORT=${SSH_PORT:-2222}
HTTP_PORT=${HTTP_PORT:-8000}
UPLOAD_PORT=${UPLOAD_PORT:-8001}

# VNC: loopback only, display number N == port 5900+N
VNC_DISPLAY=${VNC_DISPLAY:-2}

# working directory on the host (monitor socket, screendumps, transfer dirs)
LAB_DIR=/home/sharif/leonida/vm

# disks (raw partitions or images). ESP first is not required; keep the same
# set you installed with.
DISK_WINDOWS=/dev/sda3
DISK_ESP=/dev/sda1

# firmware and TPM
OVMF_CODE=/usr/share/OVMF/OVMF_CODE_4M.ms.fd
OVMF_VARS_SRC=/usr/share/OVMF/OVMF_VARS_4M.ms.fd
TPM_DIR=$LAB_DIR/tpmstate

# guest account used for ssh
GUEST_USER=${GUEST_USER:-leonida}
SSH_KEY=/home/sharif/.ssh/id_ed25519

# optional: exact monitor socket (defaults to $LAB_DIR/$VMNAME.sock)
# MON_SOCK=$HOME/lab/run/victory-win.sock
MON_SOCK=/home/sharif/leonida/vm/win.sock

# password for $GUEST_USER, used only if the key is refused
export GUEST_PASSWORD=${GUEST_PASSWORD:-leonidavm2026}

# transfer directories (guest downloads / guest uploads)
HTTP_DIR=${HTTP_DIR:-/home/sharif/leonida/drop}
UP_DIR=${UP_DIR:-/home/sharif/leonida/drop/up}
